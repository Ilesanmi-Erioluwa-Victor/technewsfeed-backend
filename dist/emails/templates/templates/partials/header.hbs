<table
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="background-color: #f8f9fa; font-family: Arial, Helvetica, sans-serif;"
>
  <tr>
    <td align="center" style="padding: 32px 20px 0 20px;">
      <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        style="max-width: 600px;"
      >
        <tr>
          <td
            align="center"
            style="background-color: #ffffff; border: 1px solid #e0e0e0; border-bottom: none; border-radius: 4px 4px 0 0;"
          >

            <table cellpadding="0" cellspacing="0" style="width: 100%;">
              <tr>
                <td style="padding: 32px 32px 24px 32px;">
                  <img
                    src="{{logoUrl}}"
                    alt="{{appName}}"
                    width="160"
                    height="auto"
                    style="display: block; margin: 0 auto; max-width: 160px; height: auto; border: 0;"
                  />
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>