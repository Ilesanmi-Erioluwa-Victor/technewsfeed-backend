<table
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="background-color: #f9fafb; padding: 20px 0;"
>
  <tr>
    <td align="center">
      <table
        width="600"
        cellpadding="0"
        cellspacing="0"
        style="background-color: white; border-radius: 10px 10px 0 0;"
      >
        <tr>
          <td style="padding: 20px; text-align: center;">
            <img
              src="{{logoUrl}}"
              alt="{{appName}} Logo"
              width="60"
              style="margin-bottom: 10px;"
            />
            <h1
              style="color: #333; font-family: Arial, sans-serif; margin: 0;"
            >{{appName}}</h1>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>