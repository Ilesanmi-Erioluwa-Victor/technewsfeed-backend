{{> header}}

<table width="600" align="center" cellpadding="0" cellspacing="0" style="background-color: white; padding: 20px;">
  <tr>
    <td>
      <h2 style="font-family: Arial, sans-serif; color: #333;">Welcome to {{appName}}, {{name}}!</h2>
      <p style="font-family: Arial, sans-serif; color: #555;">
        We're thrilled to have you onboard! Your account has been successfully created.
      </p>
      <p style="font-family: Arial, sans-serif; color: #555;">
        You can now explore, read, learn and connect with amazing reader on {{appName}}.
      </p>
      <p>
        <a href="{{loginLink}}" style="display: inline-block; padding: 10px 20px; background-color: #007bff; color: white; border-radius: 5px; text-decoration: none;">Access Your Dashboard</a>
      </p>
    </td>
  </tr>
</table>

{{> footer}}
