    "@types/nodemailer": "^7.0.3",
    "@types/xml2js": "^0.4.14",
    "nodemon": "^3.1.10",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
