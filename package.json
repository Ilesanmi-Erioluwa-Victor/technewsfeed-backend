{
  "name": "technewsfeed-backend",
  "version": "1.0.0",
  "description": "Tech news Bot",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --out-dir dist --format cjs --platform node",
    "start": "node dist/index.js",
    "generate": "npx prisma generate",
    "postbuild": "mkdir -p dist/emails && cp -r src/emails/templates dist/emails/templates"
  },
  "type": "commonjs",
