generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}



datasource db {
   provider = "postgresql" 
   
}
model Avatar {
  id         String   @id @default(uuid())
  url        String
  fileType   String?
  size       Int?
  uploadedAt DateTime @default(now())
  user       User?
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  name                String?
  isVerified          Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  avatarId            String?                  @unique
  invitedBy           String?
  isActive            Boolean                  @default(true)
  role                UserRole                 @default(USER)
  auditLogs           AuditLog[]               @relation("UserAuditLogs")
  credentials         AuthCredential[]
  posts               BlogPost[]               @relation("UserPosts")
  reviewedPosts       BlogPost[]               @relation("PostReviewer")
  comments            Comment[]                @relation("UserComments")
  subscriptions       NewsletterSubscription[]
  avatar              Avatar?                  @relation(fields: [avatarId], references: [id])
  preferences         UserPreference?
  sentInvitations     WriterInvitation[]       @relation("InvitationSender")
  receivedInvitations WriterInvitation[]       @relation("InvitationReceiver")
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  magicLinkTokens     MagicLinkToken[]

  @@index([role])
  @@index([isActive])
}

model AuthCredential {
  id         String   @id @default(uuid())
  provider   String
  password   String?
  providerId String?
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([provider, userId])
  @@index([provider])
  @@index([providerId])
  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  otp       String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model MagicLinkToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([expiresAt])
}

model WriterInvitation {
  id            String           @id @default(uuid())
  email         String           @unique
  token         String           @unique
  role          UserRole         @default(WRITER)
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  invitedById   String
  invitedUserId String?          @unique
  invitedBy     User             @relation("InvitationSender", fields: [invitedById], references: [id])
  invitedUser   User?            @relation("InvitationReceiver", fields: [invitedUserId], references: [id])

  @@index([token])
  @@index([status])
  @@index([expiresAt])
}

model BlogPost {
  id               Int            @id @default(autoincrement())
  title            String
  slug             String         @unique
  content          String?
  summary          String?
  excerpt          String?
  authorName       String?
  coverImage       String?
  publishedAt      DateTime?
  isPublished      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  authorId         String?
  isFeatured       Boolean        @default(false)
  readingTime      Int?
  reviewedAt       DateTime?
  reviewedById     String?
  scheduledPublish DateTime?
  seoDescription   String?
  seoTitle         String?
  status           PostStatus     @default(DRAFT)
  views            Int            @default(0)
  author           User?          @relation("UserPosts", fields: [authorId], references: [id])
  reviewedBy       User?          @relation("PostReviewer", fields: [reviewedById], references: [id])
  comments         Comment[]      @relation("PostComments")
  externalPosts    ExternalPost[]
  categories       Category[]     @relation("BlogPostCategories")
  tags             Tag[]          @relation("BlogPostTags")

  @@index([slug])
  @@index([publishedAt])
  @@index([status])
  @@index([authorId])
  @@index([isPublished])
}

model Comment {
  id         String   @id @default(uuid())
  content    String
  postId     Int
  authorId   String?
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isApproved Boolean  @default(true)
  isDeleted  Boolean  @default(false)
  metadata   Json?
  author     User?    @relation("UserComments", fields: [authorId], references: [id])
  post       BlogPost @relation("PostComments", fields: [postId], references: [id])

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}


model AuditCategory {
  id          String              @id @default(uuid())
  name        AuditCategoryEnum   @unique
  description String?
  icon        String?
  color       String?             @default("#6b7280")
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  auditLogs   AuditLog[]
  
  @@index([name])
  @@index([isActive])
}

model AuditLog {
  id          String        @id @default(uuid())
  action      String
  categoryId  String?
  category    AuditCategory? @relation(fields: [categoryId], references: [id])
  actorId     String?
  targetId    String?
  targetType  String?
  description String?
  payload     Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?         
  severity    String?        @default("INFO") 
  sessionId   String?       
  createdAt   DateTime       @default(now())
  actor       User?          @relation("UserAuditLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([categoryId])
  @@index([createdAt])
  @@index([severity])
  @@index([sessionId])
}
model ExternalPost {
  id          Int         @id @default(autoincrement())
  title       String
  summary     String?
  link        String      @unique
  coverImage  String?
  publishedAt DateTime
  sourceName  String
  sourceUrl   String?
  authorName  String?
  isFeatured  Boolean     @default(false)
  blogPostId  Int?
  sourceRefId Int?
  createdAt   DateTime    @default(now())
  sentiment   String?
  blogPost    BlogPost?   @relation(fields: [blogPostId], references: [id])
  sourceRef   NewsSource? @relation(fields: [sourceRefId], references: [id])

  @@index([blogPostId])
  @@index([sourceRefId])
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  slug        String     @unique
  posts       BlogPost[] @relation("BlogPostCategories")
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  slug      String     @unique
  posts     BlogPost[] @relation("BlogPostTags")
}

model NewsSource {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  url           String
  lastFetched   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  externalPosts ExternalPost[]
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  topics    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  userId    String?  @unique
  email     String   @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum UserRole {
  USER
  WRITER
  ADMIN
}

enum PostStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditCategoryEnum {
  AUTHENTICATION
  PROFILE
  SECURITY
  ACCOUNT
  CONTENT
  MODERATION
  SYSTEM
  ADMIN
  BILLING
  SUBSCRIPTION
}