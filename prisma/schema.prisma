generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Avatar {
  id         String   @id @default(uuid())
  url        String
  fileType   String?
  size       Int?              
  uploadedAt DateTime @default(now())
  user       User?     @relation
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String?
  role        UserRole @default(USER)
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  invitedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  avatar           Avatar?              @relation(fields: [avatarId], references: [id])
  avatarId         String?               @unique
  receivedInvitations WriterInvitation[] @relation("InvitationReceiver")
  reviewedPosts        BlogPost[]        @relation("PostReviewer")
  comments             Comment[]         @relation("UserComments")
  auditLogs            AuditLog[]        @relation("UserAuditLogs")
  posts                BlogPost[]        @relation("UserPosts")
  preferences          UserPreference[]
  subscriptions        NewsletterSubscription[]
  sentInvitations      WriterInvitation[] @relation("InvitationSender")

  @@index([role])
  @@index([isActive])
}


model WriterInvitation {
  id             String   @id @default(uuid())
  email          String   @unique
  token          String   @unique
  role           UserRole @default(WRITER)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invitedBy      User   @relation("InvitationSender", fields: [invitedById], references: [id])
  invitedById    String
  invitedUser    User?  @relation("InvitationReceiver", fields: [invitedUserId], references: [id])
  invitedUserId  String?

  @@index([token])
  @@index([status])
  @@index([expiresAt])
}


model BlogPost {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  content        String?
  summary        String?
  excerpt        String?
  coverImage     String?
  status         PostStatus @default(DRAFT)
  author         User?    @relation("UserPosts", fields: [authorId], references: [id])
  authorId       String?
  authorName     String? 
  views          Int       @default(0)         
  readingTime    Int?                           
  seoTitle       String?                       
  seoDescription String?                      
  isFeatured     Boolean   @default(false) 
  publishedAt    DateTime?
  isPublished    Boolean   @default(false)
  reviewedBy     User?    @relation("PostReviewer", fields: [reviewedById], references: [id])
  reviewedById   String?
  reviewedAt     DateTime?
  scheduledPublish DateTime? 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comments       Comment[]     @relation("PostComments")
  categories     Category[]    @relation("BlogPostCategories")
  tags           Tag[]         @relation("BlogPostTags")
  externalPosts  ExternalPost[]

  @@index([slug])
  @@index([publishedAt])
  @@index([status])
  @@index([authorId])
  @@index([isPublished])
}


model Comment {
  id          String   @id @default(uuid())
  content     String
  post        BlogPost @relation("PostComments", fields: [postId], references: [id])
  postId      Int
  author      User?    @relation("UserComments", fields: [authorId], references: [id])
  authorId    String?
  parentId    String?              
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isApproved  Boolean  @default(true) 
  isDeleted   Boolean  @default(false) 
  metadata    Json?                  

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}



model AuditLog {
  id          String   @id @default(uuid())
  action      String
  actorId     String?
  actor       User?    @relation("UserAuditLogs", fields: [actorId], references: [id])
  targetId    String?
  targetType  String?
  description String?
  payload     Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}



model ExternalPost {
  id             Int        @id @default(autoincrement())
  title          String
  summary        String?
  link           String      @unique       
  coverImage     String?
  publishedAt    DateTime
  sourceName     String                 
  sourceUrl      String?              
  authorName     String?
  sentiment      String?
  isFeatured     Boolean     @default(false)
  blogPost       BlogPost?   @relation(fields: [blogPostId], references: [id])
  blogPostId     Int?
  sourceRef      NewsSource? @relation(fields: [sourceRefId], references: [id])
  sourceRefId    Int?
  createdAt      DateTime    @default(now())
}


model Category {
  id             Int                     @id @default(autoincrement())
  name           String                  @unique
  slug           String                  @unique
  description    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  posts          BlogPost[]              @relation("BlogPostCategories")
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     BlogPost[] @relation("BlogPostTags")
}

model NewsSource {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  url         String
  lastFetched DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  externalPosts ExternalPost[]
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  topics    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId])
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  userId    String?
  email     String   @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum UserRole {
  USER   
  WRITER  
  ADMIN   
}

enum PostStatus {
  DRAFT     
  REVIEW    
  APPROVED  
  PUBLISHED 
  REJECTED  
  ARCHIVED  
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}